# Copy to .env for local development. Replace the explicitly marked placeholders.
# Do not use this file or its sample values as production credentials.

# Application runtime
NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/lifelink_dev
# Optional reverse-proxy hop count. Leave unset locally; set to the exact
# trusted proxy count in deployment (valid values are 1 through 10).
# TRUST_PROXY_HOPS=1
# Optional path used by the app health route and the healthcheck script.
HEALTHCHECK_PATH=/health
# Optional URL override for `npm run health`; otherwise HOST, PORT, and
# HEALTHCHECK_PATH are used. HOST defaults to 127.0.0.1.
# HEALTHCHECK_URL=
# HOST=127.0.0.1
# Comma-separated additional browser origins. Same-origin requests need no entry.
ALLOWED_ORIGIN=http://localhost:3000

# Authentication
# Development-only placeholder. NEVER use this value in production.
# Production requires a unique secret with at least 32 UTF-8 bytes.
JWT_SECRET=replace-with-a-long-random-development-secret
# Optional jsonwebtoken expiry; defaults to 1d.
JWT_EXPIRES_IN=1d
# Optional secret dedicated to phone OTP signing; defaults to JWT_SECRET.
# PHONE_OTP_SECRET=

# Application limits and behavior
# Defaults to 90 days when unset; must be a non-negative number.
DONATION_GAP_DAYS=90
# Required positive integer limits used by offer/request workflows.
MAX_ACTIVE_OFFERS=3
MAX_REQUESTS_PER_REQUESTER=3
# Legacy alias used only when MAX_REQUESTS_PER_REQUESTER is unset.
# MAX_OPEN_REQUESTS=3
# Avatar upload limit in MB; defaults to 2 when unset.
MAX_AVATAR_MB=5
# Prescription upload limit in MB; required by the upload middleware.
MAX_PRESCRIPTION_MB=3
# Verification resend window/cooldown in seconds. Defaults are 1800 and 60.
VERIFY_RESEND_WINDOW_SECONDS=1800
VERIFY_RESEND_COOLDOWN_SECONDS=60

# Cloudflare R2 private object storage
# Required for new uploads in production. Leave blank for local-only development.
# The endpoint is derived from the account ID and the SDK region is "auto".
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=

# Encrypted identity documents
# Required before uploading identity documents. Replace with a generated,
# random 32-byte key encoded as exactly 64 hexadecimal characters.
ID_DOCUMENT_ENCRYPTION_KEY=replace-with-a-generated-64-character-hex-key

# Optional one-time administrator creation script (`npm run create-admin`)
# Set these in the process environment only when running that script.
# ADMIN_NAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_PHONE=
# ADMIN_CITY=

# Email delivery (optional until email features are used)
# SMTP_PORT must be 465 or 587. SMTP_USER is also the sender address.
# SMTP_PASS is a provider credential; do not use a normal Gmail password.
FRONTEND_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# SMS / WhatsApp via Twilio (optional)
# SMS_PROVIDER must be "twilio" or "twilio-whatsapp" when enabled.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

# Error monitoring (optional)
SENTRY_DSN=
# Defaults to NODE_ENV, then "development".
SENTRY_ENVIRONMENT=development

# MongoDB backup script (optional; MONGO_URI is also used by the app)
# Blank DATABASE_BACKUP_DIR uses a private directory under the user's home.
# BACKUP_RETENTION_DAYS defaults to 14 and must be 1 through 3650.
# MONGODUMP_PATH defaults to mongodump on PATH.
DATABASE_BACKUP_DIR=
BACKUP_RETENTION_DAYS=14
MONGODUMP_PATH=mongodump

# Optional legacy Cloudinary adapter setting. Current upload routes do not use
# this adapter; setting it does not enable Cloudinary-backed uploads.
CLOUDINARY_URL=

# Test-only integration setting. Leave unset for normal development and
# production. If enabled, tests require an isolated loopback replica-set DB
# whose database name ends in "test"; the test suite writes test records there.
# LIFELINK_TEST_MONGO_URI=mongodb://127.0.0.1:27017/lifelink_test?replicaSet=rs0
